# Copy to .env and fill in. .env is gitignored - never commit a key. See SECURITY.md section 1.
#
# The harness reads the process environment only. Load the file before a run:
#   set -a; source .env; set +a
#
# Model name and revision are NOT environment variables: they are pinned in each config
# (`llm.model`, `llm.revision`) so that they are hashed into every trace header.

# Every config references ${HARNESS_LLM_BASE_URL}.
#   hosted (Gemini, OpenAI-compatible): https://generativelanguage.googleapis.com/v1beta/openai
#   local vLLM, the default for thesis runs: http://localhost:8000/v1
HARNESS_LLM_BASE_URL=http://localhost:8000/v1

# The variable NAMED by `llm.api_key_env` in the config (the bracket and pilot configs name
# GEMINI_API_KEY). A local vLLM server needs none: set `llm.api_key_env: null`.
GEMINI_API_KEY=
