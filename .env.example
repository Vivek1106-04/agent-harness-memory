# Copy to .env and fill in. .env is gitignored — never commit a key.
# See SECURITY.md §1.

# Local vLLM — the default for thesis runs (pinned open weights, zero marginal cost)
HARNESS_LLM_BASE_URL=http://localhost:8000/v1
HARNESS_LLM_MODEL=
HARNESS_LLM_REVISION=

# Hosted provider — development and debugging only.
# Free tiers cannot carry the sweep (157 days at best) but are sized right for weeks 1-7.
HARNESS_LLM_API_KEY=

# Frozen across every condition. Pin the REVISION, not just the name:
# swapping only the embedding model moves accuracy 6.2pp (MemDelta).
HARNESS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
HARNESS_EMBEDDING_REVISION=
